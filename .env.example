# ---------------------------------------------------------------------------
# 3D Print Catalog - environment configuration
# Copy this file to `.env` and adjust the values for your machine.
#
# MODELS_ROOT is REQUIRED: the application stops with an error when it is
# missing or empty, because there is no built-in library location. Every other
# variable has a documented application default (see server/config.ts).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Runtime modes: develop | staging | production
#
# APP_MODE how `npm run start:web` serves the web app
#          develop    -> Vite dev server (no build, hot reload)
#          staging    -> Vite preview of dist/ (builds once if missing)
#          production -> Vite preview of dist/ (builds once if missing)
#
# API_MODE how `npm run start:server` runs the API
#          develop    -> reload on change (tsx watch) + verbose logging
#          staging    -> no reload, verbose logging
#          production -> no reload, quiet logging
#          Outside of `develop`, the API also serves the built UI on API_PORT,
#          so a single service can expose both the app and the API.
# ---------------------------------------------------------------------------
APP_MODE=develop
API_MODE=develop

# REQUIRED. Root folder that contains one subfolder per category. Inside every
# category there may be any number of nested folders; a folder that directly
# contains at least one model file is treated as a "project".
MODELS_ROOT="/mnt/d/cortese/design/3d models"

# Ports: the web app (Vite dev server or preview) and the HTTP API.
WEB_PORT=5173
API_HOST=127.0.0.1
API_PORT=4317

# Origins allowed to call the API from a browser. Defaults to the web origin
# derived from WEB_PORT when the variable is absent.
# CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Local SQLite catalog. Created automatically on the first scan.
DB_PATH="./data/catalog.db"

# Extensions (comma separated, case insensitive) that count as a model file.
MODEL_EXTENSIONS=".stl,.3mf,.obj,.step,.stp,.sldprt"

# Directory names skipped by the scanner (comma separated). Hidden folders
# (starting with a dot) are always skipped.
IGNORE_DIRS="node_modules,.git,.svn,.idea,.vscode,System Volume Information,$RECYCLE.BIN"
