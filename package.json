{
  "name": "print-catalog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local catalogue and browser for a 3D print model library (React + Vite + shadcn/ui + SQLite).",
  "scripts": {
    "start": "concurrently -n web,server -c magenta,cyan \"npm:start:web\" \"npm:start:server\"",
    "start:web": "tsx scripts/start-web.ts",
    "start:server": "tsx scripts/start-server.ts",
    "build": "tsc -b && vite build",
    "scan": "tsx server/scan-cli.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "lucide-react": "^1.48.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
